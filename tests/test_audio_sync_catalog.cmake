cmake_minimum_required(VERSION 3.20)
if(NOT IS_DIRECTORY "${TOMBA_ROOT}/cmake" OR NOT SCRATCH)
    message(FATAL_ERROR "Pass TOMBA_ROOT and a private build SCRATCH directory")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(CMAKE_CURRENT_BINARY_DIR "${SCRATCH}/run-${nonce}")
set(original "${CMAKE_CURRENT_BINARY_DIR}/original")
file(MAKE_DIRECTORY "${original}/packages/revision-only/1.0.0")
file(WRITE "${original}/packages/revision-only/1.0.0/manifest.toml" "test fixture")
include("${TOMBA_ROOT}/cmake/TombaAudioSync.cmake")
tomba_audio_sync_catalog(staged "${original}")
if(NOT EXISTS "${staged}/packages/revision-only/1.0.0/manifest.toml")
    message(FATAL_ERROR "Regional declarations were not preserved")
endif()
file(RENAME "${original}/packages/revision-only" "${CMAKE_CURRENT_BINARY_DIR}/removed")
tomba_audio_sync_catalog(staged "${original}")
if(EXISTS "${staged}/packages/revision-only" OR NOT EXISTS "${staged}/packages/psx.audio.low-latency/1.0.1/manifest.toml")
    message(FATAL_ERROR "Stale regional package or missing shared audio declaration")
endif()
message(STATUS "PASS shared audio staging preserves current regional declarations without stale revision packages")
